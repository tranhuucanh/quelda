# Generated by scripts/homebrew-formula.mjs for each quelda release; do not
# edit in the tap (changes are overwritten). Source:
# https://github.com/tranhuucanh/quelda/blob/main/packaging/homebrew/quelda.rb.in
class Quelda < Formula
  desc "PDF security scanner: one PDF and a policy in, a verdict out"
  homepage "https://github.com/tranhuucanh/quelda"
  @MACOS_ARM@
  license "MIT"

  # macOS (Apple Silicon) only: on Linux, install the static binary (docs/cli.md).
  depends_on arch: :arm64
  depends_on :macos

  def install
    bin.install "quelda"
  end

  test do
    assert_match "quelda #{version}", shell_output("#{bin}/quelda --version")

    # A tiny PDF without an xref table: PASS (with a warning) under the default
    # preset, REJECT under strict.
    (testpath/"tiny.pdf").write <<~PDF
      %PDF-1.7
      1 0 obj << /Type /Catalog /Pages 2 0 R >> endobj
      2 0 obj << /Type /Pages /Kids [] /Count 0 >> endobj
      trailer << /Root 1 0 R >>
      %%EOF
    PDF
    assert_match '"status":"PASS"', shell_output("#{bin}/quelda scan #{testpath}/tiny.pdf")
    assert_match '"status":"REJECT"',
                 shell_output("#{bin}/quelda scan #{testpath}/tiny.pdf --preset strict", 1)

    # PostScript is always rejected.
    (testpath/"upload.pdf").write "%!PS-Adobe-3.0\n"
    assert_match "FILETYPE.POSTSCRIPT_MAGIC", shell_output("#{bin}/quelda scan #{testpath}/upload.pdf", 1)
  end
end
